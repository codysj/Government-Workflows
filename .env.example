# Copy to .env (gitignored). Nothing here is needed for the default offline mode.
#
# The app reads ONLY real environment variables; it never loads this file by
# itself. `python -m src.eval.real_llm` and the console launcher load .env
# explicitly. Leave LLM_MODE unset (or "mock") to stay offline.

# LLM_MODE=real                 # "real" uses the provider below; default "mock"
LLM_PROVIDER=openai             # "openai" = any OpenAI-compatible endpoint; "anthropic" = Messages API
LLM_API_KEY=                    # read from the environment only; never logged
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=deepseek/deepseek-v4.1-flash   # a cheap model is plenty for drafting
# Vendor-specific request fields merged into the body (JSON object). For
# reasoning models on OpenRouter, turn hidden reasoning off so it can't eat
# the token budget:
LLM_EXTRA_BODY={"reasoning":{"enabled":false}}

# Storage (defaults shown)
LEDGER_DB=runs/ledger.db
