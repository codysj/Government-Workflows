# Copy to .env (gitignored). Nothing here is needed for the default offline mode.
#
# The API and CLI read only real environment variables. The console launcher,
# the MCP server (mcp_server.py), and `python -m src.eval.real_llm` load this
# file explicitly. Leave LLM_MODE unset (or "mock") to stay offline.

# LLM_MODE=real                 # "real" uses the provider below; default "mock"
LLM_PROVIDER=openai             # "openai" = any OpenAI-compatible endpoint; "anthropic" = Messages API
LLM_API_KEY=                    # read from the environment only; never logged
LLM_MODEL=deepseek/deepseek-v4.1-flash   # a cheap model is plenty for drafting

# OpenRouter (what the measured results used). For OpenAI itself or the
# Anthropic Messages API, leave these two commented out.
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Vendor-specific request fields merged into the body (JSON object). For
# reasoning models on OpenRouter, turn hidden reasoning off so it can't eat
# the token budget:
# LLM_EXTRA_BODY={"reasoning":{"enabled":false}}

# MCP server (Claude / ChatGPT; see docs/mcp.md). The Claude extension sets the
# first two from its settings.
# GOVWF_DATA_DIR=C:\Users\me\Documents\Finance exports   # tools read files only here
# GOVWF_HOME=C:\path\to\Government-Workflows\runs         # run history, audit log, exports
# GOVWF_DOWNLOAD_HOSTS=oaiusercontent.com,openai.com     # where ChatGPT attachments may come from
# GOVWF_AI_API_KEY / _PROVIDER / _MODEL / _BASE_URL: set by the Claude extension's
# optional AI settings (not read from this file's LLM_* lines).
